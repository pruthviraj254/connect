# App environment (local dev / local builds — CI sets these per release workflow)
# production | staging | development
NEXT_PUBLIC_APP_ENV=production
# Production RXAdmin API (include /api prefix) — renderer reference only; main uses RX_CONNECT_* below
NEXT_PUBLIC_API_BASE_URL=https://portal-api.myonerx.com/api

# Portal auth (main process only)
RX_CONNECT_PORTAL_API_BASE_URL=https://portal-api.myonerx.ca
RX_CONNECT_API_BASE_URL=https://portal-api.myonerx.com/api
RX_CONNECT_HTTP_TIMEOUT_MS=15000
RX_CONNECT_AUTH_REFRESH_SKEW_MS=60000

# Dev-only: show "Continue without sign-in" until portal login API is ready (never enable in production builds)
RX_CONNECT_DEV_SKIP_AUTH=true
NEXT_PUBLIC_RX_CONNECT_DEV_SKIP_AUTH=true

# External forgot-password page (renderer)
NEXT_PUBLIC_FORGOT_PASSWORD_URL=https://portal.myonerx.com
# Staging local dev example:
# NEXT_PUBLIC_APP_ENV=staging
# NEXT_PUBLIC_API_BASE_URL=https://api.staging.onerx.com/api
# Local backend example:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# Or: RX_CONNECT_CHANNEL=staging pnpm --filter @rx-connect/desktop run dev

# Rx Connect CDR list (Call Log) — main process only; never expose in renderer bundle
# RX_CONNECT_INGEST_SECRET=

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Dev: Next dev server URL for Electron main (set by pnpm dev in apps/desktop)
# ELECTRON_RENDERER_URL=http://127.0.0.1:3000

# Website Builder — live publish (loaded from repo-root .env in dev)
VERCEL_API_TOKEN=vercel_dummy_token_replace_me
# Optional: Vercel team (not personal account)
VERCEL_TEAM_ID=team_dummy_id_replace_me

# --- Domain / URL mode ---
# DEFAULT: leave SITE_BASE_DOMAIN empty → sites publish to https://rx-{site-id}.vercel.app
# (No OneRx-owned domain required. Same site ID = same URL on republish.)

# SITE_BASE_DOMAIN=
# SITE_USE_PLATFORM_DOMAIN=false

# LATER (when OneRx owns a domain on Vercel, e.g. rxsites.com):
# SITE_BASE_DOMAIN=rxsites.com
# SITE_USE_PLATFORM_DOMAIN=true

# Optional: one shared Vercel project when using platform subdomains
# VERCEL_PROJECT_NAME=rx-pharmacy-sites

# Fax outbound (print popup → Send Fax). Use mock until real API is wired.
FAX_PROVIDER=mock
# FAX_PROVIDER=telnyx
# TELNYX_API_KEY=
# TELNYX_FAX_CONNECTION_ID=
# TELNYX_FAX_FROM=
