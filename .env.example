# App
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=https://api.onerx.com

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Dev: Next dev server URL for Electron main (set by pnpm dev in apps/desktop)
# ELECTRON_RENDERER_URL=http://127.0.0.1:3000

# Website Builder — live publish (loaded from repo-root .env in dev)
VERCEL_API_TOKEN=vercel_dummy_token_replace_me
# Optional: Vercel team (not personal account)
VERCEL_TEAM_ID=team_dummy_id_replace_me

# --- Domain / URL mode ---
# DEFAULT: leave SITE_BASE_DOMAIN empty → sites publish to https://rx-{site-id}.vercel.app
# (No OneRx-owned domain required. Same site ID = same URL on republish.)

# SITE_BASE_DOMAIN=
# SITE_USE_PLATFORM_DOMAIN=false

# LATER (when OneRx owns a domain on Vercel, e.g. rxsites.com):
# SITE_BASE_DOMAIN=rxsites.com
# SITE_USE_PLATFORM_DOMAIN=true

# Optional: one shared Vercel project when using platform subdomains
# VERCEL_PROJECT_NAME=rx-pharmacy-sites

# Fax outbound (print popup → Send Fax). Use mock until real API is wired.
FAX_PROVIDER=mock
# FAX_PROVIDER=telnyx
# TELNYX_API_KEY=
# TELNYX_FAX_CONNECTION_ID=
# TELNYX_FAX_FROM=
