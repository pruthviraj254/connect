{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**", ".vite/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
  "lint": {
    "dependsOn": []
  },
    "typecheck": {
      "dependsOn": ["^build"]
    },
  "test": {
    "dependsOn": []
  }
  }
}
