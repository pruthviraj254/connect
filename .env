# App
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Portal auth (main process) — server origin only (no /api suffix)
RX_CONNECT_PORTAL_API_BASE_URL=http://localhost:3001
# Product API — include /api prefix (CDR, etc.)
RX_CONNECT_API_BASE_URL=http://localhost:3001/api
RX_CONNECT_HTTP_TIMEOUT_MS=15000
RX_CONNECT_AUTH_REFRESH_SKEW_MS=60000

# Must match RX_CONNECT_INGEST_SECRET on RXAdmin_BE
RX_CONNECT_INGEST_SECRET=166be1ad06e5c1e9990ccf573143e1ebf1f47301ce45b7bb463b75be5c2a2638
NEXT_PUBLIC_RX_CONNECT_INGEST_SECRET=166be1ad06e5c1e9990ccf573143e1ebf1f47301ce45b7bb463b75be5c2a2638

# Dev-only: skip portal login (uses hardcoded dev pharmacy in authService)
RX_CONNECT_DEV_SKIP_AUTH=true
NEXT_PUBLIC_RX_CONNECT_DEV_SKIP_AUTH=true

# External forgot-password page (renderer link — not the API URL)
NEXT_PUBLIC_FORGOT_PASSWORD_URL=http://localhost:5001

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Website Builder — Vercel publish
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=team_dummy_id_replace_me

# Fax outbound (print popup → Send Fax). Use mock until real API is wired.
FAX_PROVIDER=mock
