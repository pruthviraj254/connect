# App
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Website Builder — Vercel publish
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=team_dummy_id_replace_me

# Default: use https://rx-{site-id}.vercel.app (no OneRx domain needed)
# Do NOT set rxsites.com until you own it on Vercel:
# SITE_BASE_DOMAIN=rxsites.com
# SITE_USE_PLATFORM_DOMAIN=true
# Fax outbound (print popup → Send Fax). Use mock until real API is wired.
FAX_PROVIDER=mock
